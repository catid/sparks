{
  "env": {
    "shellEnv": {
      "enabled": false,
      "timeoutMs": 15000
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "vllm/deepseek-v4-flash",
        "fallbacks": []
      },
      "utilityModel": "vllm/deepseek-v4-flash",
      "models": {
        "vllm/deepseek-v4-flash-dspark-mia-throughput": null,
        "vllm/deepseek-v4-flash": {
          "alias": "ds4f",
          "params": {
            "temperature": 1,
            "topP": 1
          },
          "agentRuntime": {
            "id": "openclaw"
          }
        },
        "openai/gpt-5.6-sol": {
          "alias": "sol",
          "agentRuntime": {
            "id": "openclaw"
          }
        }
      },
      "thinkingDefault": "xhigh",
      "reasoningDefault": "off",
      "elevatedDefault": "off",
      "timeoutSeconds": 3600,
      "contextTokens": 393216,
      "maxConcurrent": 2,
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      },
      "compaction": {
        "mode": "safeguard",
        "timeoutSeconds": 1800,
        "keepRecentTokens": 50000,
        "recentTurnsPreserve": 3,
        "identifierPolicy": "strict",
        "qualityGuard": {
          "enabled": true,
          "maxRetries": 1
        },
        "midTurnPrecheck": {
          "enabled": true
        },
        "postIndexSync": "async",
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 8000,
          "forceFlushTranscriptBytes": "10mb"
        },
        "truncateAfterCompaction": true,
        "maxActiveTranscriptBytes": "20mb",
        "notifyUser": true
      },
      "subagents": {
        "maxConcurrent": 2,
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 2,
        "runTimeoutSeconds": 1800
      },
      "experimental": {
        "localModelLean": false
      }
    }
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": [
      "llm-task"
    ],
    "elevated": {
      "enabled": false
    },
    "loopDetection": {
      "enabled": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "vllm": {
        "baseUrl": "http://spark1.lan:8889/v1",
        "api": "openai-completions",
        "timeoutSeconds": 3600,
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash DSpark NVFP4 TP2",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 1048576,
            "maxTokens": 65536,
            "compat": {
              "supportsTools": true,
              "supportsUsageInStreaming": true,
              "supportsReasoningEffort": true,
              "supportsStrictMode": false,
              "maxTokensField": "max_tokens",
              "thinkingFormat": "deepseek",
              "requiresReasoningContentOnAssistantMessages": true,
              "supportedReasoningEfforts": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ],
              "reasoningEffortMap": {
                "low": "high",
                "medium": "high",
                "high": "high",
                "xhigh": "max",
                "max": "max"
              }
            }
          }
        ]
      }
    }
  },
  "channels": {
    "slack": {
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist"
    }
  },
  "plugins": {
    "allow": [
      "openai",
      "exa",
      "slack",
      "llm-task"
    ],
    "entries": {
      "openai": {
        "enabled": true
      },
      "exa": {
        "enabled": true
      },
      "llm-task": {
        "enabled": true,
        "config": {
          "defaultProvider": "openai",
          "defaultModel": "gpt-5.6-sol",
          "allowedModels": [
            "openai/gpt-5.6-sol"
          ],
          "maxTokens": 16384,
          "timeoutMs": 300000
        }
      }
    }
  }
}
