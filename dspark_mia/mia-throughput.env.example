# Render this template with ../scripts/configure-dspark-profile.sh. The output
# is both Bash-sourceable and Docker Compose --env-file compatible. It contains
# no credentials.

MIA_PROJECT_NAME=@MIA_PROJECT_NAME@
WORKER_HOST=@WORKER_HOST@
WORKER_INSTALL_DIR="@PROJECT_DIR@/dspark_mia"
CLUSTER_SSH_KEY="@CLUSTER_SSH_KEY@"

MASTER_ADDR=@SPARK1_CX7_IP@
MASTER_PORT=@MASTER_PORT@
NODE_RANK=0
HEADLESS=
VLLM_HOST_IP=@SPARK1_CX7_IP@
WORKER_VLLM_HOST_IP=@SPARK2_CX7_IP@
VLLM_HOST=0.0.0.0
VLLM_PORT=@VLLM_PORT@

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8
DSPARK_MODEL_HOST_PATH="@DSPARK_MODEL_HOST_PATH@"
DSPARK_MODEL=/models/deepseek-ai--DeepSeek-V4-Flash-DSpark--62af8fffb2f7030cac4de2f0169f5b8d1101b646
DSPARK_MODEL_REPO=deepseek-ai/DeepSeek-V4-Flash-DSpark
DSPARK_MODEL_REVISION=62af8fffb2f7030cac4de2f0169f5b8d1101b646
SERVED_MODEL_NAME=deepseek-v4-flash-dspark-mia-throughput

HF_CACHE="@HOME@/.cache/huggingface"
WORKER_HF_CACHE="@HOME@/.cache/huggingface"
DSPARK_TMP_HOST="@HOME@/.cache/dspark-mia-throughput-tmp"
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

# Keep prefill activation pressure bounded while the larger speculative graph
# set is captured. With k=5/C32, vLLM reserves 32*(5-1)=128 draft slots,
# leaving 8,064 scheduled tokens from this 8,192-token budget. Chunked prefill
# admits a 32x~1,024-token wave in five chunks. The graph ceiling is
# 32*(5+1)=192; the pinned runtime captured the complete set through 192.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=192
GPU_MEMORY_UTILIZATION=0.78
MTP_NUM_TOKENS=5
ENABLE_VLLM_GB10_PATCH=0

# Four logical RoCE rails over the two direct ConnectX-7 cables. The :0/:1
# suffixes are NCCL rail IDs. Do not add a scalar NCCL_IB_GID_INDEX.
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA='=rocep1s0f0:1:0,roceP2p1s0f0:1:0,rocep1s0f1:1:1,roceP2p1s0f1:1:1'
NCCL_NETDEVS_POLICY=ALL
NCCL_CROSS_NIC=0
NCCL_IB_MERGE_NICS=0
NCCL_SOCKET_IFNAME='=enp1s0f0np0'
NCCL_SOCKET_FAMILY=AF_INET
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_DMABUF_ENABLE=1
NCCL_NET_GDR_C2C=1
NCCL_IB_QPS_PER_CONNECTION=1
NCCL_IB_SPLIT_DATA_ON_QPS=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH
TORCH_NCCL_ASYNC_ERROR_HANDLING=1

CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
