# Audited low-concurrency OpenClaw/agent profile for this checkout. This file
# is shell-compatible as well as Compose-compatible and contains no
# credentials. Render mia-agent.env.example for a different checkout/user.

MIA_PROJECT_NAME=mia-dspark-agent
WORKER_HOST=spark2
WORKER_INSTALL_DIR=/home/catid/dgx-spark-laguna/dspark_mia
CLUSTER_SSH_KEY=/home/catid/.ssh/id_ed25519_dgx_cluster

MASTER_ADDR=192.168.100.10
MASTER_PORT=29632
NODE_RANK=0
HEADLESS=
VLLM_HOST_IP=192.168.100.10
WORKER_VLLM_HOST_IP=192.168.100.11
VLLM_HOST=0.0.0.0
VLLM_PORT=8889

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8
DSPARK_MODEL_HOST_PATH=/home/catid/models/DeepSeek-V4-Flash-0731-Abliterated-FP8--7d02640c
DSPARK_MODEL=/models/apetersson--DeepSeek-V4-Flash-0731-Abliterated-FP8--7d02640c
DSPARK_MODEL_REPO=apetersson/DeepSeek-V4-Flash-0731-Abliterated-FP8
DSPARK_MODEL_REVISION=7d02640c72a2c8127f116d3d1933ddfec5e4c0fa
MIA_MODEL_LOCK=MODEL.abliterated-fp8.lock.json
# Retain the existing client-facing ID while the agent profile serves the
# abliterated checkpoint, so OpenClaw requires no model-name change.
SERVED_MODEL_NAME=deepseek-v4-flash-dspark-mia-throughput
# Canonical OpenClaw/DeepSeek ID. vLLM advertises both names so existing
# clients keep working while OpenClaw activates its DeepSeek V4 request policy.
SERVED_MODEL_ALIASES=deepseek-v4-flash

HF_CACHE=/home/catid/.cache/huggingface
WORKER_HF_CACHE=/home/catid/.cache/huggingface
DSPARK_TMP_HOST=/home/catid/.cache/dspark-mia-agent-tmp
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

# C8 capacity with complete target+DSpark k5 graph coverage through 8 active
# requests. Long contexts remain chunked through the 8,192-token scheduler
# budget; requests above C8 queue.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=48
GPU_MEMORY_UTILIZATION=0.78
MTP_NUM_TOKENS=5
ENABLE_VLLM_GB10_PATCH=0

# Same proven four-rail topology as the throughput profile; no scalar GID
# index.
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA='=rocep1s0f0:1:0,roceP2p1s0f0:1:0,rocep1s0f1:1:1,roceP2p1s0f1:1:1'
NCCL_NETDEVS_POLICY=ALL
NCCL_CROSS_NIC=0
NCCL_IB_MERGE_NICS=0
NCCL_SOCKET_IFNAME='=enp1s0f0np0'
NCCL_SOCKET_FAMILY=AF_INET
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_DMABUF_ENABLE=1
NCCL_NET_GDR_C2C=1
NCCL_IB_QPS_PER_CONNECTION=1
NCCL_IB_SPLIT_DATA_ON_QPS=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH
TORCH_NCCL_ASYNC_ERROR_HANDLING=1

CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
