# Throughput benchmark profile. This is a full, shell/Compose-compatible copy
# of mia.env with isolated project/ports/tmp state and a 32-sequence scheduler.
# It contains no credentials.

MIA_PROJECT_NAME=mia-dspark-throughput
WORKER_HOST=cerebrus2
WORKER_INSTALL_DIR=/home/catid/dgx-spark-laguna/dspark_mia
CLUSTER_SSH_KEY=/home/catid/.ssh/id_ed25519_dgx_cluster

MASTER_ADDR=10.10.84.28
MASTER_PORT=29631
NODE_RANK=0
HEADLESS=
VLLM_HOST_IP=10.10.84.28
WORKER_VLLM_HOST_IP=10.10.84.12
VLLM_HOST=0.0.0.0
VLLM_PORT=8889

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8
DSPARK_MODEL_HOST_PATH=/home/catid/models/DeepSeek-V4-Flash-DSpark-official
DSPARK_MODEL=/models/deepseek-ai--DeepSeek-V4-Flash-DSpark--62af8fffb2f7030cac4de2f0169f5b8d1101b646
DSPARK_MODEL_REPO=deepseek-ai/DeepSeek-V4-Flash-DSpark
DSPARK_MODEL_REVISION=62af8fffb2f7030cac4de2f0169f5b8d1101b646
SERVED_MODEL_NAME=deepseek-v4-flash-dspark-mia-throughput
SERVED_MODEL_ALIASES=deepseek-v4-flash

HF_CACHE=/home/catid/.cache/huggingface
WORKER_HF_CACHE=/home/catid/.cache/huggingface
DSPARK_TMP_HOST=/home/catid/.cache/dspark-mia-throughput-tmp
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

# Keep prefill activation pressure bounded while the much larger speculative
# graph set is captured. With k=5/C32, vLLM reserves 32*(5-1)=128 draft slots,
# leaving 8,064 scheduled tokens from this 8,192 budget. Chunked prefill safely
# admits the 32x~1,024-token wave in five chunks. The graph ceiling is
# 32*(5+1)=192; the pinned runtime captured the complete set through 192.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=192
GPU_MEMORY_UTILIZATION=0.78
MTP_NUM_TOKENS=5
ENABLE_VLLM_GB10_PATCH=0

# Rank-specific HCAs select the two logical links on the direct TP2 edge.
# Bootstrap, Gloo, and rendezvous stay on the management interface.
NCCL_NET=IB
NCCL_IB_DISABLE=0
HEAD_NCCL_IB_HCA='=rocep1s0f1:1:0,roceP2p1s0f1:1:0'
WORKER_NCCL_IB_HCA='=rocep1s0f0:1:0,roceP2p1s0f0:1:0'
NCCL_NETDEVS_POLICY=ALL
NCCL_CROSS_NIC=0
NCCL_IB_MERGE_NICS=0
NCCL_SOCKET_IFNAME='=enP7s7'
NCCL_SOCKET_FAMILY=AF_INET
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
TP_SOCKET_IFNAME=enP7s7
GLOO_SOCKET_IFNAME=enP7s7
NCCL_DMABUF_ENABLE=1
NCCL_NET_GDR_C2C=1
NCCL_IB_QPS_PER_CONNECTION=1
NCCL_IB_SPLIT_DATA_ON_QPS=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH
TORCH_NCCL_ASYNC_ERROR_HANDLING=1

CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
