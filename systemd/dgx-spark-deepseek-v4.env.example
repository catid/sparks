# Install this file as /etc/dgx-spark-deepseek-v4.env on both Sparks.
# Keep the inference settings identical on the two nodes. The values below are
# the selected TP2+DFlash all-eager production profile. It prioritizes one
# maximum-context thinking/agent request over concurrent request capacity.

USE_NCCL_230=1
DEEPSEEK_TARGET=/home/catid/models/DeepSeek-V4-Flash-NVFP4
DEEPSEEK_DFLASH=/home/catid/models/DeepSeek-V4-Flash-speculator.dflash
DEEPSEEK_SERVED_MODEL=deepseek-v4-flash-nvfp4
DEEPSEEK_LOAD_FORMAT=auto
DEEPSEEK_ENFORCE_EAGER=1
DEEPSEEK_DFLASH_ENFORCE_EAGER=1
# Explicitly opt out of vLLM's automatic breakable-CUDA-graph path. Both the
# target and DFlash drafter stay eager in this profile.
VLLM_USE_BREAKABLE_CUDAGRAPH=0

# -1 asks vLLM to auto-fit the largest context supported by available KV
# cache. Read the resolved maximum from the startup log after every stack or
# memory-layout change instead of assuming the checkpoint's advertised limit.
DEEPSEEK_MAX_MODEL_LEN=-1
DEEPSEEK_MAX_NUM_SEQS=1
DEEPSEEK_MAX_BATCHED_TOKENS=4096
DEEPSEEK_GPU_MEMORY_UTILIZATION=0.90
DEEPSEEK_ENABLE_CHUNKED_PREFILL=1
DEEPSEEK_DISABLE_HYBRID_KV=0

VLLM_MASTER_ADDR=192.168.100.10
VLLM_MASTER_PORT=29618
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
HF_HUB_OFFLINE=1

DEEPSEEK_NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH

# Spark 1 uses these settings to manage Spark 2's headless rank. The remote
# command is fixed in manage-deepseek-v4-rank1.sh; these values never become
# remote shell syntax.
DEEPSEEK_RANK1_HOST=192.168.100.11
DEEPSEEK_RANK1_SSH_USER=catid
DEEPSEEK_RANK1_CONTROL_PROTOCOL=forced-command-v1
DEEPSEEK_RANK1_SSH_KEY=/home/catid/.ssh/id_ed25519_deepseek_v4_rank1_control
DEEPSEEK_RANK1_KNOWN_HOSTS=/home/catid/.ssh/known_hosts
DEEPSEEK_RANK1_WAIT_TIMEOUT_SECONDS=300
DEEPSEEK_RANK1_STOP_TIMEOUT_SECONDS=330
DEEPSEEK_RANK1_POLL_SECONDS=2
DEEPSEEK_RANK1_STABLE_SECONDS=5
