[Unit]
Description=Wait for all four DGX Spark ConnectX-7 RoCE rails
Documentation=file:@PROJECT_DIR@/docs/NETWORKING.md
Wants=NetworkManager.service network-online.target
After=NetworkManager.service network-online.target local-fs.target
Before=dgx-spark-dspark-mia.service

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@PROJECT_DIR@/bin/wait-cx7-ready.sh --wait
# Do not remain active: each model start must pull in a fresh rail check.
TimeoutStartSec=infinity
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
