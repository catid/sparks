[Unit]
Description=DeepSeek V4 Flash NVFP4+DFlash TP2 vLLM headless rank 1
Documentation=file:/home/catid/dgx-spark-laguna/systemd/README-deepseek-v4.md
Requires=dgx-spark-cx7-ready.service
Wants=network-online.target
After=local-fs.target network-online.target dgx-spark-cx7-ready.service
Conflicts=dgx-spark-laguna-vllm-agent.service

[Service]
Type=simple
User=catid
Group=catid
WorkingDirectory=/home/catid/dgx-spark-laguna
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/dgx-spark-deepseek-v4.env
ExecStart=/usr/bin/env DGX_NODE_RANK=1 /home/catid/dgx-spark-laguna/bin/launch-deepseek-v4-2node.sh tp2-dflash
# Rank 0 owns the cluster restart generation and restarts this unit over SSH.
Restart=no
KillSignal=SIGINT
KillMode=mixed
SuccessExitStatus=SIGINT 130 143
TimeoutStartSec=35min
TimeoutStopSec=5min
LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=infinity
OOMPolicy=stop
UMask=0027
