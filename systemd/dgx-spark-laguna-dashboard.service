[Unit]
Description=DGX Spark Laguna inference dashboard
Documentation=file:/home/catid/dgx-spark-laguna/dashboard/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=catid
Group=catid
WorkingDirectory=/home/catid/dgx-spark-laguna
Environment=HOME=/home/catid
Environment=DASHBOARD_SSH_CONTROL_DIR=/run/dgx-spark-laguna-dashboard/ssh
EnvironmentFile=-/etc/default/dgx-spark-laguna-dashboard
ExecStart=/home/catid/dgx-spark-laguna/dashboard/run-dashboard.sh
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
RuntimeDirectory=dgx-spark-laguna-dashboard
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
