# Loopback is safest. Visit through:
# ssh -L 8090:127.0.0.1:8090 "${USER}@cerberus1.lan"
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8090
DASHBOARD_INTERVAL=2
# Keep local and token telemetry responsive without creating a remote PAM
# session at the same frequency.
DASHBOARD_REMOTE_INTERVAL=30

# For direct LAN access, bind to Cerberus 1's LAN name and require Basic auth:
# DASHBOARD_HOST=cerberus1.lan
# DASHBOARD_AUTH=operator:replace-with-a-long-random-password
#
# scripts/install-dashboard.sh --web keeps this loopback bind behind Nginx and
# writes a random DASHBOARD_AUTH when no credential is supplied.

SPARK2_SSH_HOST=cerberus2
SPARK2_SSH_KEY=${HOME}/.ssh/id_ed25519_dgx_cluster
DASHBOARD_SSH_KNOWN_HOSTS=${HOME}/.ssh/known_hosts

# Leave SPARK1_SSH_HOST unset while this process runs on Cerberus 1. A dedicated
# third-host collector sets both SPARK1_SSH_HOST and SPARK1_SSH_KEY; see
# dashboard.remote.env.example.

# Two-node tensor-parallel topology: rank 0 owns the only HTTP API and its
# Prometheus counters are already cluster-wide. Rank 1 is a headless worker.
DASHBOARD_INFERENCE_MODE=direct
SPARK1_VLLM_ROLE=aggregate
SPARK2_VLLM_ROLE=worker
SPARK1_VLLM_URL=http://127.0.0.1:8889

# Legacy independent-replica/router mode:
# DASHBOARD_INFERENCE_MODE=router
# SPARK1_VLLM_ROLE=replica
# SPARK2_VLLM_ROLE=replica
# SPARK2_VLLM_URL=http://cerberus2.local:8000
VLLM_ROUTER_URL=http://127.0.0.1:8080
VLLM_ROUTER_METRICS_URL=http://127.0.0.1:29000
