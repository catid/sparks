# Third-host collector profile. The dashboard process runs on a separate
# Linux host; both Cerberus nodes are sampled with read-only SSH probes.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8090
DASHBOARD_INTERVAL=2
DASHBOARD_REMOTE_INTERVAL=30

# Use user-qualified hosts when the monitoring account differs from the local
# service account. Private keys and known_hosts stay outside this repository.
SPARK1_SSH_HOST=monitor@cerberus1.local
SPARK1_SSH_KEY=${HOME}/.ssh/id_ed25519_dgx_dashboard
SPARK2_SSH_HOST=monitor@cerberus2.local
SPARK2_SSH_KEY=${HOME}/.ssh/id_ed25519_dgx_dashboard
DASHBOARD_SSH_KNOWN_HOSTS=${HOME}/.ssh/known_hosts

# TP2 rank 0 is the sole aggregate HTTP endpoint. Limit port 8889 on Cerberus 1
# to this collector host and intended API clients at the site firewall.
DASHBOARD_INFERENCE_MODE=direct
SPARK1_VLLM_ROLE=aggregate
SPARK2_VLLM_ROLE=worker
SPARK1_VLLM_URL=http://cerberus1.local:8889

# The router URLs are unused in direct mode.
VLLM_ROUTER_URL=http://127.0.0.1:8080
VLLM_ROUTER_METRICS_URL=http://127.0.0.1:29000
