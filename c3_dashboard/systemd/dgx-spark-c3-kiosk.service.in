[Unit]
Description=DGX Spark C3 1424x280 Xorg dashboard kiosk
Documentation=file:@PROJECT_DIR@/c3_dashboard/README.md
Wants=network-online.target
Requires=dgx-spark-c3-dashboard.service
After=network-online.target
After=systemd-user-sessions.service systemd-logind.service plymouth-quit-wait.service
After=dgx-spark-c3-dashboard.service
After=getty@tty7.service
Conflicts=getty@tty7.service
ConditionPathExists=/dev/tty0
ConditionPathExistsGlob=/dev/dri/card[0-9]*
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Group=@GROUP@
PAMName=login
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty7
UtmpMode=user
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=/etc/default/dgx-spark-c3-dashboard
Environment=PATH=/usr/bin:/bin
Environment=RUNTIME_DIRECTORY=/run/dgx-spark-c3-kiosk
# WebKit's bubblewrap/FUSE sandbox cannot nest inside this unit's mount
# namespace. The unit already confines the process, and the kiosk permits only
# its exact loopback dashboard origin.
Environment=WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
RuntimeDirectory=dgx-spark-c3-kiosk
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/bin/chvt 7
ExecStart=@PROJECT_DIR@/c3_dashboard/scripts/launch-kiosk.sh
# pam_systemd migrates the rootless Xorg tree into a login scope. This
# root-owned installed helper verifies that scope's UID/user/service/TTY before
# terminating it, both for an ordinary stop and after an unexpected exit.
ExecStop=+@CLEANUP_HELPER@ --user @USER@ --uid @UID@ --tty tty7 --main-pid $MAINPID
ExecStopPost=+@CLEANUP_HELPER@ --user @USER@ --uid @UID@ --tty tty7
Restart=always
RestartSec=15s
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
