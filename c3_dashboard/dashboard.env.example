# The HTTP collector is loopback-only.  The GTK/WebKit process below is its
# sole intended browser on C3.
C3_DASHBOARD_HOST=127.0.0.1
C3_DASHBOARD_PORT=9763
C3_DASHBOARD_INTERVAL=5
C3_DASHBOARD_HISTORY_POINTS=720
C3_DASHBOARD_ALLOW_REMOTE=0

# C1/C2 are sampled through non-interactive, strictly host-key-checked SSH;
# C3 is sampled locally.  C1's vLLM endpoint supplies cluster token counters.
C3_DASHBOARD_NODES=cerberus1,cerberus2,cerberus3
C3_DASHBOARD_VLLM_METRICS_URL=http://cerberus1.local:8889/metrics
C3_DASHBOARD_SSH_KEY=@HOME@/.ssh/id_ed25519_dgx_cluster
C3_DASHBOARD_SSH_KNOWN_HOSTS=@HOME@/.ssh/known_hosts

# The bridge atomically replaces this privacy-safe heartbeat every two seconds.
# Keep the source inside /run; the dashboard never reads transcripts or replies.
C3_DASHBOARD_VOICE_STATUS_PATH=/run/cerberus3-voice-bridge/status.json
C3_DASHBOARD_VOICE_STALE_SECONDS=6

# The output is selected from XRandR's connected outputs at runtime.  The
# service refuses to launch WebKit unless one accepts the panel's native mode.
C3_KIOSK_URL=http://127.0.0.1:9763/
C3_KIOSK_OUTPUT=auto
C3_KIOSK_MODE=1424x280
C3_KIOSK_RETRY_SECONDS=5
C3_KIOSK_OUTPUT_WAIT_SECONDS=10
