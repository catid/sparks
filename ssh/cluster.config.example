# Replace the user and key path if your DGX Spark account differs. Management
# addresses are DHCP-owned, so every alias resolves through the canonical DNS
# name instead of pinning a lease address. Verify each host fingerprint
# independently before enabling unattended use; checking is fail-closed.
Host cerberus1 cerberus1.local cerberus1.lan cerebrus1 cerebrus1.lan spark1 spark1.lan
    HostName cerberus1.local
    User catid
    IdentityFile ~/.ssh/id_ed25519_dgx_cluster
    IdentityAgent none
    IdentitiesOnly yes
    UserKnownHostsFile ~/.ssh/dgx_cluster_known_hosts
    BatchMode yes
    ConnectTimeout 10
    StrictHostKeyChecking yes

Host cerberus2 cerberus2.local cerberus2.lan cerebrus2 cerebrus2.lan spark2 spark2.lan
    HostName cerberus2.local
    User catid
    IdentityFile ~/.ssh/id_ed25519_dgx_cluster
    IdentityAgent none
    IdentitiesOnly yes
    UserKnownHostsFile ~/.ssh/dgx_cluster_known_hosts
    BatchMode yes
    ConnectTimeout 10
    StrictHostKeyChecking yes

Host cerberus3 cerberus3.local cerberus3.lan cerebrus3 cerebrus3.lan spark3 spark3.lan
    HostName cerberus3.local
    User catid
    IdentityFile ~/.ssh/id_ed25519_dgx_cluster
    IdentityAgent none
    IdentitiesOnly yes
    UserKnownHostsFile ~/.ssh/dgx_cluster_known_hosts
    BatchMode yes
    ConnectTimeout 10
    StrictHostKeyChecking yes
