# Three-node experiment. Shell- and Compose-compatible; contains no secrets.
MIA_PROJECT_NAME=mia-dspark-pp3-trial

HEAD_HOST=cerebrus1
RANK1_HOST=cerebrus2
RANK2_HOST=cerebrus3
HEAD_MGMT_IP=10.10.84.28
RANK1_MGMT_IP=10.10.84.12
RANK2_MGMT_IP=10.10.84.121
# Bulk checkpoint replication uses each rank's direct Cerebrus 1 ring edge;
# lifecycle/control SSH continues over the management addresses above.
RANK1_SYNC_HOST=192.168.0.2
RANK2_SYNC_HOST=192.168.2.2
REMOTE_INSTALL_DIR=/home/catid/dgx-spark-laguna/dspark_mia3
CLUSTER_SSH_KEY=/home/catid/.ssh/id_ed25519_dgx_cluster

# Rendezvous and API are intentionally isolated from every two-node profile.
MASTER_ADDR=10.10.84.28
MASTER_PORT=29633
VLLM_HOST=0.0.0.0
VLLM_PORT=8893

DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8
DSPARK_MODEL_HOST_PATH=/home/catid/models/DeepSeek-V4-Flash-0731-Abliterated-FP8--7d02640c
DSPARK_MODEL=/models/apetersson--DeepSeek-V4-Flash-0731-Abliterated-FP8--7d02640c
DSPARK_MODEL_REPO=apetersson/DeepSeek-V4-Flash-0731-Abliterated-FP8
DSPARK_MODEL_REVISION=7d02640c72a2c8127f116d3d1933ddfec5e4c0fa
SERVED_MODEL_NAME=deepseek-v4-flash-dspark-mia3
SERVED_MODEL_ALIASES=deepseek-v4-flash

HF_CACHE=/home/catid/.cache/huggingface
DSPARK_TMP_HOST=/home/catid/.cache/dspark-mia3-tmp
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

# The image includes both PyTorch's older NCCL and the container-compatible
# NVIDIA NCCL 2.30.7 wheel. Put the latter first so multi-subnet routing is
# active; preflight/runtime validation records version 23007.
NCCL_RUNTIME_PATH=/usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib
NCCL_EXPECTED_VERSION=23007

# TP3 is invalid for this checkpoint. The only three-GPU decomposition under
# test is one TP rank per host and three pipeline stages.
TP_SIZE=1
PP_SIZE=3
NNODES=3
MODEL_NUM_LAYERS=43
MODEL_NUM_ATTENTION_HEADS=64
MODEL_NUM_ROUTED_EXPERTS=256

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=48
GPU_MEMORY_UTILIZATION=0.78
MTP_NUM_TOKENS=5

# Target-only is the safe default: the pinned runtime previously rejected its
# native DSpark proposer with PP. MIA3_DFLASH=on enables the compatibility
# trial without changing files.
ENABLE_DSPARK=0

# Bootstrap/control uses the routable management LAN. NCCL payload transport
# is constrained to all four ConnectX-7 RoCE devices in the three-node ring.
CONTROL_IFACE=enP7s7
# The three-node runtime is valid only after Cerebrus 3 is crossed so its P0
# faces Cerebrus 2 and its P1 faces Cerebrus 1. Host readiness always passes
# this selector explicitly; it never relies on the compatibility default.
CX7_C3_PORT_MAP=c3-p0-to-c2
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA='=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1'
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_NET_PLUGIN=none
NCCL_IB_MERGE_NICS=0
NCCL_SOCKET_IFNAME='=enP7s7'
NCCL_SOCKET_FAMILY=AF_INET
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
TP_SOCKET_IFNAME=enP7s7
GLOO_SOCKET_IFNAME=enP7s7
NCCL_DMABUF_ENABLE=1
NCCL_NET_GDR_C2C=1
NCCL_IB_QPS_PER_CONNECTION=1
NCCL_IB_SPLIT_DATA_ON_QPS=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET,GRAPH
TORCH_NCCL_ASYNC_ERROR_HANDLING=1

CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
