[Unit]
Description=Cerberus always-on local voice assistant on cerebrus3
Documentation=file:@PROJECT_DIR@/voice_assistant/README.md
Wants=cerebrus3-openclaw-voice.service cerebrus3-qwen3-asr.service cerebrus3-audio8.service
Requires=cerebrus3-voice-bridge.service
After=network-online.target
After=cerebrus3-openclaw-voice.service cerebrus3-qwen3-asr.service cerebrus3-audio8.service
Before=cerebrus3-voice-bridge.service

[Install]
WantedBy=multi-user.target
